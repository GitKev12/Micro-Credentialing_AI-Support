    {
      "name": "ST-002 Assessment Data",
      "item": [
        {
          "name": "Candidate rewrites the questions on a posted paper",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refused', () => pm.response.to.have.status(403));",
                  "console.log('ST-002 edit paper -> ' + pm.response.code + ' ' + pm.response.json().message);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id\": \"g1\",\n      \"q\": \"Rewritten by the candidate\",\n      \"choices\": [{ \"id\": \"a\", \"text\": \"Yes\" }, { \"id\": \"b\", \"text\": \"No\" }],\n      \"key\": \"a\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/assessors/{{assessorId}}/classes/{{courseId}}/assessments/{{quizId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assessors",
                "{{assessorId}}",
                "classes",
                "{{courseId}}",
                "assessments",
                "{{quizId}}"
              ]
            }
          },
          "id": "78aff5a2-5561-44e4-a32c-147ef3457f9d"
        },
        {
          "name": "Candidate opens another candidate's paper",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refused', () => pm.response.to.have.status(403));",
                  "pm.test('no questions and no marks came back', () => {",
                  "  pm.expect(pm.response.json().assessment).to.be.undefined;",
                  "  pm.expect(pm.response.json().result).to.be.undefined;",
                  "});",
                  "console.log('ST-002 other candidate -> ' + pm.response.code + ' ' + pm.response.json().message);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{otherStudentId}}/assessments/{{quizId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{otherStudentId}}",
                "assessments",
                "{{quizId}}"
              ]
            }
          },
          "id": "0d8df19a-7155-4900-9964-4b87fab44d8b"
        },
        {
          "name": "Open own paper, to answer it",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('opens', () => pm.response.to.have.status(200));",
                  "const paper = pm.response.json().assessment;",
                  "const answers = paper.items.map((item) => ({ itemId: item.id, choice: item.choices[0].id }));",
                  "pm.collectionVariables.set('quizAnswers', JSON.stringify(answers));",
                  "pm.collectionVariables.set('paperTotal', paper.totalPoints);",
                  "pm.collectionVariables.set('paperPassMark', paper.passMark);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}/assessments/{{quizId}}?retake=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{studentId}}",
                "assessments",
                "{{quizId}}"
              ],
              "query": [
                {
                  "key": "retake",
                  "value": "1"
                }
              ]
            }
          },
          "id": "f02dc9a8-c45c-4b9b-ac32-d1255fae170e"
        },
        {
          "name": "Candidate submits a mark of their own choosing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const result = pm.response.json().result || pm.response.json();",
                  "const total = Number(pm.collectionVariables.get('paperTotal'));",
                  "const passMark = Number(pm.collectionVariables.get('paperPassMark'));",
                  "pm.test('the mark sent in the request was ignored', () => {",
                  "  pm.expect(result.score).to.not.eql(999);",
                  "  pm.expect(result.score).to.be.at.most(total);",
                  "});",
                  "pm.test('pass or fail follows the mark, not the request', () => {",
                  "  pm.expect(Boolean(result.passed)).to.eql(result.score >= passMark);",
                  "});",
                  "console.log('ST-002 forged mark -> asked for 999 and passed:true, recorded ' + result.score + '/' + total + ', passed ' + result.passed);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": {{quizAnswers}},\n  \"durationMs\": 300000,\n  \"score\": 999,\n  \"passed\": true,\n  \"aiGrading\": { \"status\": \"graded\", \"score\": 999 },\n  \"credential\": { \"status\": \"issued\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}/assessments/{{quizId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{studentId}}",
                "assessments",
                "{{quizId}}",
                "submit"
              ]
            }
          },
          "id": "3fada766-8c7b-4367-b8f7-67e72d00a051"
        }
      ],
