# Copy to server/.env and fill in. Never commit the filled copy.

# Local only — Render injects its own PORT.
PORT=5000

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database

# Signs session tokens. At least 32 characters; the server refuses to start
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Comma-separated origins allowed to call this API. Unset reflects any origin,
# which is fine locally and wrong in production.
CORS_ORIGIN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Email for the Forgot password OTP, sent through Mailgun. While SMTP_USER or
# SMTP_PASS is empty, the OTP is printed in the server console instead.
# EU-region Mailgun domains use smtp.eu.mailgun.org.
SMTP_HOST=smtp.mailgun.org
# 2525, because Render's free plan blocks 587 and 465.
SMTP_PORT=2525
# true only for port 465.
SMTP_SECURE=false
# Mailgun: Send > Sending > Domain settings > SMTP credentials,
# e.g. postmaster@mg.yourdomain.com and the password made there.
SMTP_USER=
SMTP_PASS=
# The sender name shown in the inbox. The address is SMTP_USER.
EMAIL_FROM=mcredentialingsys
