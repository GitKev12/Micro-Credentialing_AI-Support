# Copy to server/.env and fill in. Never commit the filled copy.

# Local only — Render injects its own PORT.
PORT=5000

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database

# Signs session tokens. At least 32 characters; the server refuses to start
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Comma-separated origins allowed to call this API. Unset reflects any origin,
# which is fine locally and wrong in production.
CORS_ORIGIN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional, and only read by the admin API Usage dashboard. An Organization
# Admin key (sk-admin-…) with api.usage.read, which the project key above does
# not carry — without it the "Billed by OpenAI" panel reports why it is empty.
# Everything else on that dashboard works from this server's own log.
OPENAI_ADMIN_KEY=
