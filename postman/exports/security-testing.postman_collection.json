            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "id": "edb431d5-897f-4167-bc28-4f70ce873917"
        },
        {
          "name": "Read the record before it is changed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('record reads', () => pm.response.to.have.status(200));",
                  "const student = pm.response.json().student || pm.response.json();",
                  "const parts = String(student.name).trim().split(' ');",
                  "pm.collectionVariables.set('originalLastName', parts[parts.length - 1]);",
                  "console.log('ST-003 name before: ' + student.name);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
