{
  "info": {
    "name": "Micro-Credentialing — Performance Testing (PT-001..PT-004)",
    "description": "Response-time runs for the four core features in the Performance Testing form. Each folder is one test ID and can be run on its own with -i. PT-003 makes a paid OpenAI call and is kept in its own folder for that reason.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "2eba0d5e-b006-421d-9aa8-966d6917522b"
  },
