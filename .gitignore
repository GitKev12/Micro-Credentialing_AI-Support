node_modules/
dist/
.DS_Store
*.log

server/.env
server/.cache/

# Per-machine Claude Code tool approvals. Untracked on purpose: the saved
# commands keep whatever arguments they were approved with, which has already
# included a database connection string once.
.claude/settings.local.json

# Written by scripts/hash-passwords.mjs --write, and holds exactly what that
# script exists to remove from the database. Meant to be deleted, not kept.
plaintext-passwords-backup-*.json

# Written by scripts/resize-tos-quizzes.mjs --write before it overwrites the
# blueprints. A rollback for one run on one machine's database, not something
# the repository needs to carry.
tos-backup-*.json
client/.env
client/.env.local
client/.env.development.local
client/.env.test.local
client/.env.production.local

# Jest
coverage/

# Cygwin/Git-Bash crash dumps. Written wherever the shell happened to be
# standing when it fell over, so they turn up at any depth.
*.stackdump

# Written before the Assessment collection is pruned. One machine's rollback
# for one run, and it carries question keys — not something the repository
# should hold.
assessment-backup-*.json

# Written by scripts/trim-assessment-banks.mjs --write before it cuts each
# paper down from the bank it used to be. Holds the whole discarded bank, keys
# included, and exists only to be fed back through that script's --restore.
assessment-bank-backup-*.json
