# Copy to server/.env and fill in. Never commit the filled copy.

# Local only — Render injects its own PORT.
PORT=5000

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database

# Signs session tokens. At least 32 characters; the server refuses to start
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Comma-separated origins allowed to call this API. Unset reflects any origin,
# which is fine locally and wrong in production.
CORS_ORIGIN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Email for the Forgot password OTP, sent from a Gmail account. While SMTP_USER
# or SMTP_PASS is empty, the OTP is printed in the server console instead.
SMTP_HOST=smtp.gmail.com
# Render's free plan blocks 587; the API runs on a paid plan for this.
SMTP_PORT=587
# true only for port 465.
SMTP_SECURE=false
# The Gmail address, and its App Password from
# myaccount.google.com/apppasswords (needs 2-Step Verification). Not the
# normal Gmail password.
SMTP_USER=
SMTP_PASS=
# The sender name shown in the inbox. The address is SMTP_USER.
EMAIL_FROM=mcredentialingsys
