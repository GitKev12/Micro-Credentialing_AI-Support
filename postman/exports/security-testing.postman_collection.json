                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assessors/{{assessorId}}/classes/{{courseId}}/assessments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assessors",
                "{{assessorId}}",
                "classes",
                "{{courseId}}",
                "assessments"
              ]
