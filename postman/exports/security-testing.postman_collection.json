        {
          "name": "Put a script tag and quotes into a core field",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('saved without error', () => pm.response.to.have.status(200));",
                  "const student = pm.response.json().student || pm.response.json();",
                  "pm.test('kept as plain text, character for character', () => {",
                  "  pm.expect(student.name).to.include(\"<script>alert('x')</script>\");",
                  "  pm.expect(student.name).to.include('O\\'Brien\\\"; DROP TABLE Student; --');",
                  "});",
                  "pm.test('the rest of the record is untouched', () => {",
                  "  pm.expect(student.studentNumber).to.eql(pm.variables.get('studentIdentifier'));",
                  "  pm.expect(student.enrolled.length).to.be.above(0);",
                  "});",
                  "console.log('ST-003 name after: ' + student.name);"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
