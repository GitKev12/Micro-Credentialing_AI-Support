              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refused', () => pm.response.to.have.status(403));",
                  "pm.test('told why, and nothing else', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('You do not have access to this resource.');",
                  "  pm.expect(pm.response.text()).to.not.include('items');",
                  "});",
                  "console.log('ST-001 assessor assessments -> ' + pm.response.code + ' ' + pm.response.json().message);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
